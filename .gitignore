# Byte-compiled / optimized / DLL files
# פייתון מתרגם את הקוד לשפת מכונה 
# זה קורה אוטומטית כשמריצים את הקוד. אין סיבה להעלות את זה כי זה נוצר מחדש לבד,
__pycache__/
*.py[codz]
*$py.class
.venv/        #זו תקיית הסביבה הוירטואלית, אין צורך להוריד את כולה, יותר קל ונוח להוריד רק את קובץ התלויות שהכנתי
__pycache__/
.idea/        #  הגדרות של PyCharm (לא רוצים לכפות הגדרות עורך על אחרים)
*.pyc

# C extensions
#  קבצים בינאריים. לא מעלים קבצים מקומפלים.
*.so

# Distribution / packaging
# כשבונים חבילה להפצה (כמו התקנה), נוצרות תיקיות זמניות.
# אנחנו רוצים את הקוד, לא את ההתקנה הסופית.
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
#  כלי שהופך פייתון לקובץ exe. אלו קבצי לוגים וזבל שנוצרים בתהליך.
*.manifest
*.spec

# Installer logs
# אם הייתה שגיאה בהתקנה, נוצר קובץ לוג. זה לא חלק מהקוד.
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
# כשמריצים טסטים, נוצרים דוחות (כמה אחוז מהקוד נבדק).
# הדוחות האלו משתנים כל הזמן ולא מעניינים את גיטהאב.
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py.cover
.hypothesis/
.pytest_cache/
cover/

# Translations
# קבצי תרגום שפה בינאריים.
*.mo
*.pot

# Django stuff:
#  קבצים ספציפיים ל-Django (פיתוח ווב).
# ה-log זה יומן ריצה (משתנה כל שנייה), וה-db.sqlite3 זה הדאטה בייס המקומי שלך!
# אסור להעלות דאטה בייס אמיתי לגיט!
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# Flask stuff:
instance/
.webassets-cache

# Scrapy stuff:
.scrapy

# Sphinx documentation
docs/_build/

# PyBuilder
.pybuilder/
target/

# Jupyter Notebook
# קבצי שמירה זמניים של מחברות ג'ופיטר.
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

