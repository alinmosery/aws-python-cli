# Environments
# === החלק הכי חשוב בקובץ!!! ===
# כאן אנחנו אומרים לגיט להתעלם מתיקיות הסביבה הוירטואלית.
# למה? כי הסביבה מכילה אלפי קבצים של ספריות (boto3, requests).
# אנחנו לא מעלים את הספריות עצמן, אלא רק את הקובץ requirements.txt שמסביר איזה ספריות צריך.
# כל מפתח יתקין לעצמו את הספריות במחשב שלו.
.env       # בדרך כלל מכיל סיסמאות. אסור שיעלה לעולם
.envrc
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Spyder project settings
.spyderproject
.spyproject

# Rope project settings
.ropeproject

# mkdocs documentation
/site

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

